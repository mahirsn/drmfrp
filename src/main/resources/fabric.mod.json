{
  "schemaVersion": 1,
  "id": "drmfrp",
  "version": "${version}",
  "name": "Dont reload my fucking resource packs",
  "description": "Skips the resource reload when a server pushes packs you already have. Reloads are faster, recent servers' packs stay ready, and known packs show up while they download.",
  "authors": [
    "mahirsn"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "modmenu": [
      "com.mahirsn.drmfrp.ModMenuIntegration"
    ]
  },
  "mixins": [
    "drmfrp.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  },
  "icon": "assets/drmfrp/icon.png",
  "contact": {
    "sources": "https://github.com/mahirsn/drmfrp"
  },
  "suggests": {
    "modmenu": "*"
  }
}
